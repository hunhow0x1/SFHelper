{
  "name": "sfhelper",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop Soulframe companion - account snapshots, progression tracking and loadouts",
  "type": "module",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe": "node scripts/probe-endpoints.mjs",
    "start": "tsx src/server/start.ts",
    "helper": "tsx helper/cli.ts",
    "extract-names": "node scripts/extract_names.mjs",
    "build-totems": "tsx scripts/build_data.ts totems",
    "build-runes": "tsx scripts/build_data.ts runes",
    "build-weapons": "tsx scripts/build_data.ts weapons",
    "build-pacts": "tsx scripts/build_data.ts pacts",
    "build-tempers": "tsx scripts/build_data.ts tempers",
    "build-pactarts": "tsx scripts/build_data.ts pactarts",
    "build-totemdata": "tsx scripts/build_data.ts totemdata",
    "build-tempericons": "tsx scripts/build_data.ts tempericons",
    "build-enemies": "node scripts/build_enemies.mjs",
    "build-masteryrank": "tsx scripts/build_data.ts masteryrank",
    "watch-log": "node scripts/watch_log.mjs",
    "build:app": "node scripts/build_app.mjs",
    "app": "npm run build:app && electron .",
    "dist": "npm run build:app && electron-builder",
    "dist:linux": "npm run build:app && electron-builder --linux AppImage",
    "dist:win": "npm run build:app && electron-builder --win nsis"
  },
  "dependencies": {
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "ooz-wasm": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.hunhow0x1.sfhelper",
    "productName": "SFHelper",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "artifactName": "SFHelper-${version}.${ext}"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "artifactName": "SFHelper-Setup-${version}.${ext}",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true,
    "koffi@2.16.3": true
  }
}
