{
  "line": "^\\s*[\\d.]+\\s+(?<category>\\w+)\\s+\\[(?<level>\\w+)\\]:\\s*(?<message>.*)$",
  "rules": [
    {
      "id": "build-label",
      "kind": "build",
      "confidence": "verified",
      "pattern": "^Build Label:\\s*(?<build>.+)$",
      "sample": "0.035 Sys [Diag]: Build Label: 2026.08.20.11.07 Retail Windows x64 [Stripped]"
    },
    {
      "id": "login-done",
      "kind": "session",
      "confidence": "verified",
      "pattern": "^Background\\.lua: Background::OnLoginDone\\(\\)$",
      "sample": "Script [Info]: Background.lua: Background::OnLoginDone()"
    },
    {
      "id": "login-dispatch",
      "kind": "session",
      "confidence": "verified",
      "pattern": "^MainMenu\\.lua: DispatchLogin\\(\\)$",
      "sample": "Script [Info]: MainMenu.lua: DispatchLogin()"
    }
  ]
}
