{
  "name": "sfhelper",
  "version": "0.0.0",
  "private": true,
  "description": "Desktop Soulframe companion - account snapshots, progression tracking and world data",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "probe": "node scripts/probe-endpoints.mjs",
    "start": "tsx src/server/server.ts",
    "helper": "tsx helper/cli.ts",
    "extract-names": "node scripts/extract_names.mjs"
  },
  "dependencies": {
    "ooz-wasm": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
