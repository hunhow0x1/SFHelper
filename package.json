{
  "name": "sfhelper",
  "version": "0.4.67",
  "private": true,
  "description": "Desktop Soulframe companion - account snapshots, progression tracking and loadouts",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "tsx src/server/start.ts",
    "helper": "tsx helper/cli.ts",
    "build-game-data": "tsx scripts/build_game_data.ts",
    "update-agari": "tsx scripts/update_agari.ts",
    "build-totems": "tsx scripts/build_data.ts totems",
    "build-weapons": "tsx scripts/build_data.ts weapons",
    "build-pactarts": "tsx scripts/build_data.ts pactarts",
    "build-tempericons": "tsx scripts/build_data.ts tempericons",
    "build:app": "node scripts/build_app.mjs",
    "app": "npm run build:app && electron .",
    "dist": "npm run build:app && electron-builder",
    "dist:linux": "npm run build:app && electron-builder --linux AppImage",
    "dist:win": "npm run build:app && electron-builder --win nsis",
    "release:linux": "npm run build:app && electron-builder --linux AppImage --publish always",
    "release:win": "npm run build:app && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "koffi": "^2.9.0"
  },
  "devDependencies": {
    "@bokuweb/zstd-wasm": "^0.0.27",
    "@types/node": "^26.2.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.24.0",
    "ooz-wasm": "^2.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "com.hunhow0x1.sfhelper",
    "productName": "SFHelper",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "electronLanguages": [
      "en-US"
    ],
    "files": [
      "dist/**/*",
      "package.json",
      "LICENSE",
      "!node_modules/koffi/{src,vendor,doc,lib}/**",
      "!node_modules/koffi/build/koffi/!(win32_x64)/**",
      "!node_modules/koffi/build/koffi/win32_x64/*.{exp,lib}"
    ],
    "asarUnpack": [
      "**/node_modules/koffi/**"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "SFHelper-${version}.${ext}",
      "files": [
        "dist/**/*",
        "package.json",
        "LICENSE",
        "!node_modules/koffi/**"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "artifactName": "SFHelper-Setup-${version}.${ext}",
      "compression": "maximum"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hunhow0x1",
        "repo": "SFHelper",
        "releaseType": "draft"
      }
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.24.2": true,
    "esbuild@0.28.2": true,
    "koffi@2.16.3": true
  }
}
